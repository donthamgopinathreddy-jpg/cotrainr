<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/water_notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/water_notification_title"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/water_notification_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/water_notification_body"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="start"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/water_pill_250"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/water_notification_pill_bg"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="+250 ml"
            android:textColor="@color/water_notification_pill_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/water_pill_500"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/water_notification_pill_bg"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="+500 ml"
            android:textColor="@color/water_notification_pill_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
